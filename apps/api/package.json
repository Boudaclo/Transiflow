{
  "name": "@transport/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "jest --runInBand",
    "db:migrate": "node dist/migrate-cli.js",
    "db:bootstrap": "node dist/bootstrap-admin.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.0",
    "@transport/shared": "*",
    "argon2": "^0.45.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.0",
    "@transport/offline": "^0.1.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.0",
    "fake-indexeddb": "^6.2.8",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testRegex": ".*\\.spec\\.ts$",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/test"
    ],
    "globalSetup": "<rootDir>/test/global-setup.ts",
    "testTimeout": 60000
  }
}
