POSTGRES_USER=transport
POSTGRES_PASSWORD=change-me
POSTGRES_DB=transport
# Mot de passe de l'utilisateur applicatif (soumis à la RLS). Caractères URL-safe uniquement.
APP_DB_PASSWORD=change-me-app
# 32 caractères minimum
JWT_SECRET=change-me-use-at-least-32-random-characters
# 32 caractères minimum. Chiffre les clés privées de signature des QR : à NE JAMAIS changer après les premières ventes (sinon les clés deviennent illisibles), à sauvegarder à part.
SIGNING_KEY_SECRET=change-me-signing-secret-at-least-32-chars
# Premier compte plateforme, créé au démarrage s'il n'existe pas (mot de passe : 10 caractères minimum)
BOOTSTRAP_ADMIN_EMAIL=admin@exemple.bf
BOOTSTRAP_ADMIN_PASSWORD=change-me-too-please
