{
  "name": "transport-saas",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:shared": "npm run build -w packages/shared",
    "lint": "eslint .",
    "arch": "depcruise apps/api/src --config .dependency-cruiser.cjs",
    "test": "npm run build:libs && npm test --workspaces --if-present",
    "build": "npm run build:libs && npm run build -w apps/api && npm run build -w apps/web",
    "build:libs": "npm run build -w packages/shared && npm run build -w packages/offline"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "dependency-cruiser": "^16.5.0",
    "eslint": "^9.12.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0"
  }
}
